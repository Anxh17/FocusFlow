# FocusFlow Server Configuration
# Never commit real API keys to version control.

# AI provider: "openrouter" (default, free models), "gemini", or "deterministic"
AI_PROVIDER=openrouter
PORT=3001

# Optional comma-separated allowed CORS origins for split frontend/backend deployments
# Example: CORS_ORIGIN=https://focusflow.vercel.app
CORS_ORIGIN=

# Optional frontend API base URL (only needed when frontend and backend are on different domains)
# Example: VITE_API_BASE_URL=https://focusflow-api.onrender.com
VITE_API_BASE_URL=

# OpenRouter configuration (primary provider, free models only)
# Default fast free model; "openrouter/free" is also supported as an alternative
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct:free
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_ATTEMPT_TIMEOUT_MS=15000

# Optional Gemini configuration (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Optional timeouts in milliseconds
GEMINI_TIMEOUT_MS=60000
GEMINI_ATTEMPT_TIMEOUT_MS=15000
